---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import Sketchfab from '../../components/Sketchfab.astro';
import { projects, workOrder, researchOrder, getProject } from '../../data/projects';
import { media } from '../../data/media';
export function getStaticPaths() { return projects.map(project => ({params:{slug:project.slug},props:{project}})); }
const {project} = Astro.props;
const visuals = media[project.slug];
const order = project.sections.includes('Work') ? workOrder : researchOrder;
const next = getProject(order[(order.indexOf(project.slug)+1)%order.length]);
---
<Base title={project.title} description={project.shortDescription} image={visuals.cover.image}>
  <header class="project-intro"><div class="breadcrumbs">{project.sections.map(section => <a href={`/${section.toLowerCase()}/`}>{section}</a>)}<span>{project.year}</span></div><h1>{project.title}</h1><p>{project.type}</p></header>
  <figure class:list={['project-hero',{'portrait':visuals.cover.image.height > visuals.cover.image.width}]}><Image src={visuals.cover.image} alt={visuals.cover.alt} widths={[600,1000,1600,2200]} sizes="(max-width: 1440px) 90vw, 1296px" format="webp" quality={88} loading="eager" fetchpriority="high" /><figcaption>{visuals.cover.caption}</figcaption></figure>
  <div class="project-body text-layout"><div class="project-copy"><p class="lead">{project.shortDescription}</p>{project.extendedNote.map(note => <p>{note}</p>)}</div><aside class="project-meta" aria-label="Project information"><dl>{project.author && <><dt>Author</dt><dd>{project.author}</dd></>}{project.role && <><dt>Role</dt><dd>{project.role}</dd></>}{project.location && <><dt>Location</dt><dd>{project.location}</dd></>}{project.tools.length > 0 && <><dt>Tools</dt><dd>{project.tools.join(' · ')}</dd></>}{project.project && <><dt>Project</dt><dd>{project.project}</dd></>}{project.funding && <><dt>Funding</dt><dd>{project.funding}</dd></>}</dl></aside></div>
  {visuals.gallery.length > 0 && <section class="page-section" aria-label="Selected project visuals"><Gallery visuals={visuals.gallery} /></section>}
  {(project.publications.length > 0 || project.awards.length > 0) && <section class="detail-section text-layout" aria-labelledby="publications"><h2 id="publications">Publications &amp; recognition</h2><div>{project.publications.map(publication => <article class="publication"><h3><a href={publication.url}>{publication.title} ↗</a></h3><p>{publication.citation}</p></article>)}{project.awards.map(award => <p>{award}</p>)}</div></section>}
  {project.interactiveOutputs.length > 0 && project.slug !== 'chinese-pavilion-cibulka' && <section class="detail-section text-layout" aria-labelledby="outputs"><h2 id="outputs">Interactive outputs</h2><div>{project.interactiveOutputs.map(output => <p><a class="text-link" href={output.url}>{output.title} — View StoryMap ↗</a></p>)}</div></section>}
  {project.slug === 'chinese-pavilion-cibulka' && <Sketchfab />}
  {project.projectWebsites.length > 0 && <section class="detail-section text-layout" aria-labelledby="websites"><h2 id="websites">Project websites</h2><ul class="plain-list">{project.projectWebsites.map(url => <li><a href={url}>{new URL(url).hostname} ↗</a></li>)}</ul></section>}
  {project.teachingContext && <section class="detail-section text-layout" aria-labelledby="teaching"><h2 id="teaching">Teaching context</h2><div><p>{project.teachingContext.course}</p><a href={project.teachingContext.url}>{project.teachingContext.practical} ↗</a></div></section>}
  {(project.dataCredits.length > 0 || visuals.credit) && <section class="detail-section text-layout" aria-labelledby="credits"><h2 id="credits">Sources &amp; credits</h2><div>{project.dataCredits.map(credit => <p class="small">{credit}</p>)}{visuals.credit && <p class="small">{visuals.credit}</p>}</div></section>}
  <nav class="next-project" aria-label="Next project"><span class="eyebrow">Continue exploring</span><a href={`/projects/${next.slug}/`}>{next.title} <span aria-hidden="true">↗</span></a></nav>
</Base>
